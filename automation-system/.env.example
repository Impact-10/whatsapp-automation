# ─── Database ───────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Authentication ──────────────────────────────────────────────────────────
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-a-strong-random-secret-here
# Optional one-time seed admin (shared project, allowlisted admins only)
# ADMIN_SEED_EMAIL=admin@yourclient.com
# ADMIN_SEED_PASSWORD=change-me-strong-password

# ─── Google Sheets ───────────────────────────────────────────────────────────
# Option A (local): path to service-account.json file (relative to automation-system/)
GOOGLE_SERVICE_ACCOUNT=../service-account.json

# Option B (cloud / Render): paste the full JSON content of service-account.json as a single line
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Google Sheet ID (from the sheet URL)
SHEET_ID=your-google-sheet-id-here
# Or use the full URL instead:
# SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# Column range to read/write
SHEET_RANGE=Sheet1!A:G

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Cron expression for daily reminder run (default: 9 AM)
CRON_SCHEDULE=0 9 * * *
APP_TIMEZONE=Asia/Kolkata

# ─── WhatsApp ────────────────────────────────────────────────────────────────
WHATSAPP_SESSION_PATH=./sessions
WHATSAPP_CLIENT_ID=default
# How often to back up the WhatsApp session to the DB (ms). Default: 5 minutes.
WHATSAPP_REMOTE_BACKUP_INTERVAL_MS=300000
PUPPETEER_HEADLESS=true

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=5000
MAX_SEND_RETRIES=3

# ─── API Server ──────────────────────────────────────────────────────────────
API_PORT=3000
# NODE_ENV=production   # uncomment on Render / prod deployment

# ─── Testing ─────────────────────────────────────────────────────────────────
TEST_SENDER=+91XXXXXXXXXX
TEST_RECEIVER=+91XXXXXXXXXX
